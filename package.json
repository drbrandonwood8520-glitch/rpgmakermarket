{
  "name": "rpgm-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply rpgm-store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rpgm-store-db --remote",
    "db:seed": "wrangler d1 execute rpgm-store-db --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260101.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
